@article{silver1990intracellular,
  author  = {Silver, I. A. and Ereci{\'n}ska, M.},
  title   = {Intracellular and extracellular changes of [{Ca2+}] in hypoxia and ischemia in rat brain in vivo},
  journal = {The Journal of General Physiology},
  year    = {1990},
  volume  = {95},
  number  = {5},
  pages   = {837--866},
  doi     = {10.1085/jgp.95.5.837},
  pmid    = {2163431},
  note    = {Second source for the calcium driving force of decision 9.113 (Raimondo et al. 2015, Table 1, is the first). TYPESET PAGE HELD AND READ: the owner supplied the publisher's scan on 6 November 2026 as data/raw/supplied_papers/pmid2163431_silver1990.pdf (SHA-256 dc7186fa3d95dbec674b637d90a173ae9ebd1cb8471da21ebfad5aa442931c1b, 30 pages, pinned beside it; data/raw is gitignored, so it is not redistributed), and a Fable pass read its page images that day, the file's own text layer being a 2003 OCR of the back issue. Identity confirmed from p. 837: "Intracellular and Extracellular Changes of [Ca2+] in Hypoxia and Ischemia in Rat Brain In Vivo", "IAN A. SILVER and MARIA ERECINSKA", "J. GEN. PHYSIOL. (C) The Rockefeller University Press - 0022-1295/90/05/0837/30 $2.00", "Volume 95 May 1990 837-866"; received 7 December 1988, accepted 23 October 1989 (p. 860). The only copyright statement printed on the article is that imprint line; the article carries no licence text of its own. Open access under CC BY-NC-SA 4.0 by the publisher's later retrospective licence, which is carried by the article's PMC record and not by the printed page: PMC2216343's JATS permissions element (read on Fable on 6 November 2026 through Europe PMC's REST service) states "This article is distributed under the terms of an Attribution-Noncommercial-Share Alike-No Mirror Sites license for the first six months after the publication date (see http://www.rupress.org/terms). After six months it is available under a Creative Commons License (Attribution-Noncommercial-Share Alike 4.0 Unported license, as described at http://creativecommons.org/licenses/by-nc-sa/4.0/)"; published 1 May 1990, so the six-month clause has lapsed. Quoted from the typeset page, exponents as typeset superscripts: "Under normoxic conditions neuronal [Ca2+]i varied between <10^-8 and 10^-7 M from cell to cell but no systematic regional differences were observed" (abstract, p. 837); "Concentrations of external calcium in the three regions of the brain investigated in this work were 1.49-1.56 mM (Table II), which is somewhat higher than the 1.2-1.3-mM value found by earlier investigators (Hansen and Zeuthen, 1981; Harris et al., 1981; Siemkowicz and Hansen, 1981; see Hansen, 1985 for review)" (Discussion, section "[Ca2+]e and pH in Brain in Normoxia", p. 856 in full; the sentence does not straddle pp. 855-856 as the OCR reading of 6 November 2026 supposed); "In some cells levels as low as 10^-9 M were observed and in others [Ca2+]i reached 10^-7 M" (Results, p. 848). Table II (p. 848), "[Ca2+]i, [Ca2+]e, and Membrane Potential in Rat Brain Cortex, Hippocampus, and Thalamus", whose unit row reads 10^-8 M, 10^-3 M and mV, and whose footnote reads "[Ca2+]i, [Ca2+]e, and membrane potential were measured as described in the Methods. Values represent means +/- SD for the number of cells indicated in parentheses.": [Ca2+]i 7.44 +/- 2.7 (n = 81), 6.93 +/- 2.2 (n = 104), 6.89 +/- 1.9 (n = 89) x 10^-8 M; [Ca2+]e 1.56 +/- 0.32 (n = 72), 1.49 +/- 0.4 (n = 80), 1.51 +/- 0.3 (n = 87) mM; Em -68 +/- 8.7 (n = 108), -67 +/- 9.8 (n = 124), -58 +/- 7.3 (n = 97) mV, for cortex, hippocampus and thalamus. Every value the earlier OCR reading gave is confirmed, including the unit row it had to infer from the Results ("a mean of ~7 x 10^-8 M", "~1.5 x 10^-3 M", p. 848). At 310.15 K the regional means give E_Ca +132 to +134 mV, the abstract's cell-to-cell extremes +128 to +160 mV (9.113's "+159" is that figure truncated), and the 10^-9 M floor +191 mV; the authors' own equation (2) takes 310 degrees and Em = -68 mV with [Ca2+]o = 1.5 mM (p. 856). Ion-selective microelectrodes in anaesthetised rat cortex, hippocampus and thalamus}
}

@article{dreyfus2010selective,
  author  = {Dreyfus, Fanny M. and Tscherter, Anne and Errington, Adam C. and Renger, John J. and Shin, Hee-Sup and Uebele, Victor N. and Crunelli, Vincenzo and Lambert, R{\'e}gis C. and Leresche, Nathalie},
  title   = {Selective {T}-type calcium channel block in thalamic neurons reveals channel redundancy and physiological impact of {IT}window},
  journal = {The Journal of Neuroscience},
  year    = {2010},
  volume  = {30},
  number  = {1},
  pages   = {99--109},
  doi     = {10.1523/JNEUROSCI.4305-09.2010},
  pmid    = {20053892},
  note    = {FULL TEXT, read on Fable on 6 November 2026 as the author manuscript (UKMS28537, PMC2880440) through NCBI's PMC BioC text-mining service on www.ncbi.nlm.nih.gov (robots allowed; HTTP 200, 87,366 bytes, SHA-256 0800ba7a...bb19d4392), whose licence line reads "This file is available to download for the purposes of text mining, consistent with the principles of UK copyright law"; Europe PMC's record lists the article as cc by-nc-sa, inPMC Y, isOpenAccess N, and OpenAlex and Semantic Scholar give the published version as CC BY-NC-SA, read on neither publisher page (jneurosci.org answered HTTP 403 on 5 and 6 November 2026). The source named in decision 9.113 for a measured resting (window) T-type calcium conductance in a central neuron. The measurement: "ITwindow evoked with 10s long ramps from -100mV to -40mV had a mean amplitude of 26 +/- 7pA (n=5) and was fully blocked by 1muM TTA-P2 (Fig. 2)" in "older rats (P19-P20) that express a higher density of T-type channels and therefore display an ITwindow of measurable amplitude" (Results); Fig. 2 legend: "Note that the maximum amplitude of the current occurs around -63mV". Under current clamp "1-3muM TTA-P2 produced a 3.1 +/- 0.5mV (n=11) hyperpolarization of TC neurons held at -60mV (Fig. 3A1) that could be compensated by injecting a depolarizing DC current of 23 +/- 5pA (n=11)" and none at -70 mV; NRT neurons "5 +/- 2.2mV (n=6)", "30 +/- 1pA" (Fig. 5B). Whole-cell patch clamp of ventrobasal thalamocortical and nucleus reticularis neurons of Wistar rats (window ramps P19-P20, voltage clamp "at room temperature"; current clamp 8-20-day rats "at 32 degrees C"), with Cav3.1-/- and wild-type mouse controls; 2 mM external Ca2+, 10 mM EGTA in the pipette, leak subtracted; means +/- s.d. No cell capacitance or area is given, so no current density. At E_Ca +137.1 mV the 26 pA at -63 mV is a chord conductance of 0.13 nS, about 1.6 % of the input conductance the same cells show (23 pA / 3.1 mV = 7.4 nS); the arithmetic is in the pass's file, not in the paper. The manuscript carries no page numbers. Thalamic neurons, not the generic neuron of the registered constants. The title's subscript "window" on I(T) is flattened here. Routes that failed on 5 and 6 November 2026, each respected: PMC's body through the PubMed tool (empty), Europe PMC fullTextXML (HTTP 500), jneurosci.org (403), PMC's page (a check that the visitor is human), europepmc.org's render and hal.science (robots)}
}

@article{hughes1999thalamocortical,
  author  = {Hughes, S. W. and Cope, D. W. and T{\'o}th, T. I. and Williams, S. R. and Crunelli, V.},
  title   = {All thalamocortical neurones possess a {T}-type {Ca2+} 'window' current that enables the expression of bistability-mediated activities},
  journal = {The Journal of Physiology},
  year    = {1999},
  volume  = {517},
  number  = {Pt 3},
  pages   = {805--815},
  doi     = {10.1111/j.1469-7793.1999.0805s.x},
  pmid    = {10358120},
  note    = {FULL TEXT, all 12 of its 12 text passages read on Fable on 6 November 2026 through the Wiley Scholar Gateway (search_wiley_fulltext, which returns the article's text in passages; its record says isOpenAccess false; the gateway's extraction drops the signs +/-, - and the degree mark, restored here from context). Cited in decision 9.113 for the ratio of window T-type conductance to leak conductance as the quantity a resting calcium conductance edge would need. It gives no window-current amplitude, conductance or density: a sharp-electrode current-clamp and dynamic-clamp study in which the endogenous window is inferred, not measured. What it gives (Results): "R(N)= 143 +/- 16 MOhm, resting V=-64 +/- 1 mV, n= 36"; "(d|I(T(artificial))|/dV)max (3.81 +/- 1.14 nS) was significantly smaller than g(Leak) (6.44 +/- 1.31 nS) (P < 0.05; n= 8)"; artificial g(T) of 53.5 +/- 10.48 to 147.5 +/- 28.82 nS, i.e. g(T(artificial))/g(Leak) of 7.55 to 17.65, or an artificial inward leak of g(Leak(artificial))/g(Leak) about 0.5-0.6, make every TC neurone bistable; Discussion: "the value of g(T)/g(Leak) required to bring about intrinsic bistability is probably about twice that typically observed in vitro". Methods: 61 neurones of the rat (n = 7, male Wistar, 150-200 g) and cat (n = 54, adult) dorsal lateral geniculate nucleus, slices "perfused with a warmed (35 +/- 1 degrees C)" medium with 2 mM CaCl2, 1 M potassium acetate microelectrodes; the artificial current uses "E(Ca)= 180 mV". No capacitance or area is given. Abstract (PubMed record, 5 November 2026): "The existence of a non-negligible steady-state ('window') component of the low threshold, T-type Ca2+current (IT) and an appropriately large ratio of IT to ILeak conductance (i.e. gT/gLeak) have been shown to underlie a novel form of intrinsic bistability that is present in about 15 \% of thalamocortical (TC) neurones"; "These results demonstrate the existence of a non-negligible IT 'window' component in all TC neurones".