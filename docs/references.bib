  title     = {Mutations in {G} protein-coupled receptors: mechanisms, pathophysiology and potential therapeutic
               approaches},
  journal   = {Pharmacol. Rev.},
  year      = {2021},
  volume    = {73},
  number    = {1},
  pages     = {89--119},
  pmid      = {33219147},
  doi       = {10.1124/pharmrev.120.000011},
  note      = {Cited in the research pass behind docs/open\_decisions.md 9.20 for whether gene dosage is an axis
               apart from activating mutations, and whether raised receptor abundance changes which {G} protein a
               receptor couples to. Read in full from the owner's supplied {PDF}, 26 October 2026; the earlier
               pass had only the abstract, the article having no {PMC} identifier despite its open licence.
               Dosage is an axis of its own, with its own section {VI.A}: "In addition to classic gain- and
               loss-of-function variants, other aspects, such as biased signaling, trans-signaling, ectopic
               expression, allele variants of {GPCRs}, pseudogenes, gene fusion, and gene dosage, contribute to the
               repertoire of {GPCR} dysfunctions", and "There is currently only one example reproducibly showing
               that a locus duplication containing a {GPCR} leads to an inherited disease: the increase of
               {GPR101} copy number (locus duplication) causes {X}-linked acrogigantism and acromegaly", against
               which "Submicroscopic structural variations ... are widespread in normal human genomes and can
               increase gene dosage with no apparent effects". On the question that matters for the conditional
               edge, abundance changes the amount of signalling and not the transducer: "the total amount of a
               given receptor matters in respect to the resulting agonist-independent basal activity ... would
               increase basal {G}-protein signaling", where transducer identity is set by the allele -- "the
               {TSHR} mutation {Y601N} found in a toxic adenoma caused constitutive activation of the {Gs}
               protein/c{AMP} pathway but was unable to couple to {Gq/11} proteins". Its Table 1 names fourteen
               activating-mutation disorders, in {ADGRE2}, {AVPR2}, {CASR}, {CYSLTR2}, {FSHR}, {GPR101}, {GRM1},
               {KISS1R}, {LHCGR}, {MC2R}, {PTH1R}, {RHO}, {SMO} and {TSHR}, of which only {GPR101} is a dosage
               case; "Most are missense mutations (~95\%), and only a few are deletions or rearrangements".
               Licence {CC} {BY-NC} 4.0, read on p. 89 of the publisher's own page: "This is an open access
               article distributed under the {CC} {BY-NC} Attribution 4.0 International license", with copyright
               held by the authors}
}

@article{fukami2018gpcrgof,
  author    = {Fukami, M. and Suzuki, E. and Igarashi, M. and Miyado, M. and Ogata, T.},
  title     = {Gain-of-function mutations in {G}-protein-coupled receptor genes associated with human endocrine
               disorders},
  journal   = {Clin. Endocrinol. (Oxf.)},
  year      = {2018},
  volume    = {88},
  number    = {3},
  pages     = {351--359},
  pmid      = {29029377},
  doi       = {10.1111/cen.13496},
  note      = {Cited in the research pass behind docs/open\_decisions.md 9.20 as the catalogue of human {GPCR}
               gain-of-function mechanisms. Read in full from the owner's supplied {PDF}, 26 October 2026; the
               earlier pass had only the abstract and could not say which genes Table 1 names. They are {AVPR2},
               {LHCGR}, {FSHR}, {TSHR}, {KISS1R}, {CASR}, {PTH1R}, {GPR101}, {MC2R} and {PROKR2} in the germline
               and {LHCGR}, {TSHR} and {GPR101} somatically; no histamine receptor is among them. The mechanism
               column reads "Increased constitutive activity", "Broadened ligand sensitivity", "Increased ligand
               sensitivity", "Impaired desensitization" or "Paradoxical activation of the coexisting wild-type
               receptor", and for {GPR101}, the one copy-number-gain entry, it reads "Unknown". Copy-number gain
               appears as a mutation type: "Chromosomal microduplications on {Xq26} involving {GPR101} are known as
               genetic causes of {X-LAG}". Two sentences correct the earlier reading, which had said raised density
               is not among the listed mechanisms: abundance is named, but as a route to more signal and not to a
               different transducer -- "other mechanisms, such as enhanced cell surface expression and increased
               sensitivity to the interacting proteins, may also result in excessive signal transduction of {GPCR}
               mutants" -- while a changed transducer is attributed to the mutation, "In addition, {GPCR}
               mutations can alter the preference of the downstream signal cascades". Licence unverified: the page
               states "\copyright{} 2017 John Wiley \& Sons Ltd" and no licence. The per-page Wiley download stamp
               that ends "{OA} articles are governed by the applicable Creative Commons License" is boilerplate on
               every Wiley download and is not a statement about this article}
}

@article{parma1995tshrsomatic,
  author    = {Parma, J. and Van Sande, J. and Swillens, S. and Tonacchera, M. and Dumont, J. and Vassart, G.},
  title     = {Somatic mutations causing constitutive activity of the thyrotropin receptor are the major cause of
               hyperfunctioning thyroid adenomas: identification of additional mutations activating both the
               cyclic adenosine 3',5'-monophosphate and inositol phosphate-{Ca2+} cascades},
  journal   = {Mol. Endocrinol.},
  year      = {1995},
  volume    = {9},
  number    = {6},
  pages     = {725--733},
  pmid      = {8592518},
  doi       = {10.1210/mend.9.6.8592518},
  note      = {The decisive source against conditioning a second coupling on a {+1} seed in
               docs/open\_decisions.md 9.20: within one expression system, which transducer an activating allele
               engages is set by the allele and not by how much receptor there is. Read in full from the owner's
               supplied {PDF}, 26 October 2026, to settle the gap the earlier pass flagged, that matched expression
               across constructs was assumed and not verified. It was not matched, and the mismatch runs against
               the density reading: Fig. 3 reports the measured total receptor amount per construct, and the two
               mutants that activate the inositol phosphate cascade are the two expressed below wild type
               ({Ile486Phe} 0.15 $\pm$ 0.01 and {Ile568Thr} 0.22 $\pm$ 0.02, against wild type 0.87 $\pm$ 0.11 and
               0.61 $\pm$ 0.05, in the paper's milliunits). A receptor-dose titration says the same: "for the
               {Phe631Leu} mutant no stimulation of basal levels is observed, whatever the amount of {DNA}
               transfected", and "For identical levels of c{AMP} accumulation, the {Ile486Phe} mutant is capable of
               stimulating inositol phosphate accumulation, while {Phe631Leu} is not", which the authors read as
               "qualitative differences of these mutants as compared with others". Abstract quotes confirmed
               verbatim on p. 725: "The mutations studied up to now cause constitutive (i.e. {TSH}-independent)
               activation of the c{AMP}-regulatory cascade only" and "In addition, the {Ile486Phe} and, to a lesser
               extent, the {Ile486Met} and {Ile568Thr} mutants stimulated constitutively the inositol
               phosphate-diacylglycerol cascade". The second of those overstates the paper's own data: the
               Discussion names two mutants, not three, and Fig. 3 puts {Ile486Met}'s inositol phosphates at
               background, so the paper should be cited for {Ile486Phe} and {Ile568Thr} against {Phe631Leu}. The
               paper reports receptor amount in milliunits only and gives no absolute density. Licence unverified:
               the page states "Copyright \copyright{} 1995 by The Endocrine Society" and no licence}
}

