@article{friden2011phpartition,
  author  = {Frid{\'e}n, Markus and Bergstr{\"o}m, Fredrik and Wan, Hong and Rehngren, Mikael and Ahlin, Gustav and Hammarlund-Udenaes, Margareta and Bredberg, Ulf},
