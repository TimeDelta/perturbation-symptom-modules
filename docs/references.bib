@article{bart2005carvedilolpgp,
  author  = {Bart, Joost and Dijkers, Eli C F and Wegman, Theodora D and de Vries, Elisabeth G E and van der Graaf, Winette T A and Groen, Harry J M and Vaalburg, Willem and Willemsen, Antoon T M and Hendrikse, N Harry},
  title   = {New positron emission tomography tracer [11C]carvedilol reveals P-glycoprotein modulation kinetics},
  journal = {British Journal of Pharmacology},
  volume  = {145},
  number  = {8},
  pages   = {1045--1051},
  year    = {2005},
  doi     = {10.1038/sj.bjp.0706283},
  pmid    = {15951832},
  pmcid   = {PMC1576233},
  note    = {The evidence that bears on carvedilol under preregistration item 14(c), found 13 October 2026 in place of the measured Kp,uu,brain the item asks for. Carvedilol is used here as a tracer FOR P-glycoprotein function at the blood-brain barrier, which presupposes it is a substrate: "The beta-receptor antagonist carvedilol is a P-gp substrate with a log P=2.0"; "Ex vivo [11C]carvedilol biodistribution studies showed that [11C]carvedilol uptake in the brain was increased by CsA"; "Brain DV of [11C]carvedilol showed a dose-dependent increase of maximal three-fold after CsA pretreatment" (abstract, PubMed MCP get_article_metadata, read 13 October 2026). A brain uptake that trebles when P-gp is inhibited is efflux-limited, which points to a Kp,uu,brain below item 14(c)'s threshold of 0.1 rather than above it, so it is evidence for leaving carvedilol out rather than a missing number. Open access in PubMed Central (PMC1576233); licence not verified, no licence sentence read. Decisions 3.1 and 8.9 of docs/open_decisions.md}
}

