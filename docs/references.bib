% Added 10 October 2026 for docs/drug_entry_nodes.md: whether plasma protein binding changes a drug's effect, and how
% graph models place a drug. Every quoted sentence was read in the abstract PubMed or arXiv serves or in the article
% text, as each note says; records retrieved from PubMed are cited with the article DOI.

@article{benet2018predicting,
  author  = {Benet, Leslie Z.},
  title   = {Predicting pharmacokinetics/pharmacodynamics in the individual patient: separating reality from hype},
  journal = {The Journal of Clinical Pharmacology},
  year    = {2018},
  volume  = {58},
  number  = {8},
  pages   = {979--989},
  doi     = {10.1002/jcph.1105},
  pmid    = {29663413},
  note    = {When a change in plasma binding changes unbound exposure: "In essence, protein binding changes will only be relevant for high-extraction-ratio drugs dosed intravenously, and I estimate that fewer than 3\% of drug dosings would require concerns about changes in response due to changes in binding caused by drug-drug interactions or disease states" and, for oral dosing with hepatic elimination, "the area under the curve of unbound drug (AUC oral,u) is independent of protein binding" (article text, section on protein binding, with its Table 1). The gate is route and extraction ratio, a property of the drug and not of the drug-carrier pair (docs/drug_entry_nodes.md)}
}

@article{benet2002changes,
  author  = {Benet, Leslie Z. and Hoener, Betty-ann},
  title   = {Changes in plasma protein binding have little clinical relevance},
  journal = {Clinical Pharmacology and Therapeutics},
  year    = {2002},
  volume  = {71},
  number  = {3},
  pages   = {115--121},
  doi     = {10.1067/mcp.2002.121829},
  pmid    = {11907485},
  note    = {The analysis benet2018predicting restates. PubMed carries no abstract for it and the text was not retrieved, so nothing is quoted from it here; the title is its claim}
}

@article{hochman2015drug,
  author  = {Hochman, Jerome and Tang, Cuyue and Prueksaritanont, Thomayant},
  title   = {Drug-drug interactions related to altered absorption and plasma protein binding: theoretical and regulatory considerations, and an industry perspective},
  journal = {Journal of Pharmaceutical Sciences},
  year    = {2015},
  volume  = {104},
  number  = {3},
  pages   = {916--929},
  doi     = {10.1002/jps.24306},
  pmid    = {25557998},
  note    = {The route by extraction-ratio table for displacement from plasma proteins (dPB): "the impact of dPB will be clinically relevant only for a small set of drugs characterized by (1) high ER and parenteral administration irrespective of elimination route and (2) high ER and oral administration with nonhepatic elimination" (article text, Theoretical considerations, Table 2). The same table marks the unbound peak and trough as changed for every intravenous row, so the invariance is of average unbound exposure and not of a peak}
}

@article{hiraoka2004changes,
  author  = {Hiraoka, Haruhiko and Yamamoto, Koujirou and Okano, Nobuhiro and Morita, Toshihiro and Goto, Fumio and Horiuchi, Ryuya},
  title   = {Changes in drug plasma concentrations of an extensively bound and highly extracted drug, propofol, in response to altered plasma binding},
  journal = {Clinical Pharmacology and Therapeutics},
  year    = {2004},
  volume  = {75},
  number  = {4},
  pages   = {324--330},
  doi     = {10.1016/j.clpt.2003.12.004},
  pmid    = {15060510},
  note    = {The human test of the intravenous high-extraction case: "During cardiopulmonary bypass, a significant increase in the concentration of unbound propofol occurred without alteration in the total propofol concentration in blood. The effect of the changes of propofol's protein binding on its kinetics was consistent with the predictions based on the well-stirred model of hepatic elimination for an intravenously infused high-clearance drug" (abstract, PubMed 15060510). It reports kinetics and no measure of anaesthetic depth}
}

@article{coutant2018disease,
  author  = {Coutant, David E. and Hall, Stephen D.},
  title   = {Disease-drug interactions in inflammatory states via effects on {CYP}-mediated drug clearance},
  journal = {The Journal of Clinical Pharmacology},
  year    = {2018},
  volume  = {58},
  number  = {7},
  pages   = {849--863},
  doi     = {10.1002/jcph.1093},
  pmid    = {29505093},
  note    = {Albumin and orosomucoid do not bind alike: "Binding to albumin is generally not saturable because of its high plasma concentration (600 μM) and because of multiple binding sites in each albumin molecule. In contrast, the plasma concentration of AAG is lower (10 to 20 μM), and it has only 1 binding site. Thus, binding to AAG is displaceable and saturable" and "most drugs will bind to both albumin and AAG to varying extents" (article text, Protein-binding discussion). It also gives the unbound exposure after intravenous dosing separately for low and for high hepatic extraction}
}

@article{coutant2015understanding,
  author  = {Coutant, D. E. and Kulanthaivel, P. and Turner, P. K. and Bell, R. L. and Baldwin, J. and Wijayawardana, S. R. and Pitou, C. and Hall, S. D.},
  title   = {Understanding disease-drug interactions in cancer patients: implications for dosing within the therapeutic window},
  journal = {Clinical Pharmacology and Therapeutics},
  year    = {2015},
  volume  = {98},
  number  = {1},
  pages   = {76--86},
  doi     = {10.1002/cpt.128},
  pmid    = {25808023},
  note    = {Raised orosomucoid as a marker of lowered clearance and not as a cause of lowered effect: "increases in AAG can serve as a marker for altered drug clearance, insofar as inflammation can increase AAG in concert with increases in various cytokines, which in turn lower CYP gene expression and activity" and "In the past, it was mistakenly thought that increased toxicity would occur through altered drug free fraction via the displacement of one drug from plasma proteins by another drug or by reduced protein concentration" (article text, section on markers of decreased drug clearance). Under this account inflammation raises exposure to a sensitive CYP substrate, the opposite sign to a sequestration edge from the carrier}
}

@article{ulldemolins2011effects,
