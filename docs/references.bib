@article{fagerholm2021labvariability,
  author  = {Fagerholm, Urban and Spjuth, Ola and Hellberg, Sven},
  title   = {Comparison between lab variability and in silico prediction errors for the unbound fraction of drugs in human plasma},
  journal = {Xenobiotica},
  year    = {2021},
  volume  = {51},
  number  = {10},
  pages   = {1095--1100},
  doi     = {10.1080/00498254.2021.1964044},
  pmid    = {34346291},
  note    = {The only 117-compound figure for interlaboratory variation in human fu,plasma, cited in section 1.5a of the assay-comparability pass of 26 October 2026 for the condition this repository's own Kp,uu,brain inputs are in - values collated from the published literature across laboratories, methods and conditions. "Corresponding estimates for lab variability (ratio between max and min f[u] for each compound) were 2.0- and 185-fold, respectively. Greater than 10-fold lab variability was found for 14 of 117 selected compounds"; "predictions were about as reliable as lab estimates when these have been generated during different conditions" (abstract, PubMed 34346291, read 26 October 2026; PubMed's rendering strips the subscript on fu and the italics on "in silico"). CARRIES THE SAME CONFLICT OF INTEREST THAT DECISION 9.100 RECORDED FOR THE EXCLUDED fagerholm2022human PREPRINT: all three authors are at Prosilico AB, and the paper benchmarks laboratory variability against that company's own in silico prediction method, so it evaluates data against a product of its authors' company. Unlike the preprint this paper IS peer reviewed (Xenobiotica), so the exclusion of decision 9.100 does not reach it; but the conflict is to be disclosed wherever the 2.0-fold figure is cited, and whether to cite it at all is the owner's. An independent second source for the same term was sought and found under the second-source rule: kazmi2026iqconsortium, with di2017proteinbinding and riccardi2015challenging. Full text not reached (Taylor and Francis), so the per-compound table naming the 14 compounds above 10-fold is not held here; request 7 of section 7 of the pass. Not open access (Europe PMC isOpenAccess N)}
}

@article{kazmi2026iqconsortium,
  author  = {Kazmi, Faraz and Gradhand, Ulrike and Gangl, Eric T. and Fricke, Robert and Aldinger, Tanya and Chambers, Rob and Donzelli, Massimiliano and Ferguson, Douglas and Francq, Bernard G. and Harradine, Paul J. and Kazma, R{\'e}mi and Mardirosian, Saro and Nicolas, Jean-Marie and Shinkyo, Raku and Simon, Sandrine and Sinz, Michael and Stuart, Patricia and Tatikola, Kanaka and Wittwer, Matthias Beat and Vendrell-Navarro, Gloria and Yan, Zhengyin and Kalvass, John C.},
  title   = {Breaking the 1\% unbound threshold: an {IQ} consortium whitepaper on the evaluation of plasma protein binding of highly bound compounds},
  journal = {Drug Metabolism and Disposition},
  year    = {2026},
  volume  = {54},
  number  = {9},
  pages   = {100358},
  doi     = {10.1016/j.dmd.2026.100358},
  pmid    = {42612543},
  note    = {THE INTERLABORATORY NOISE FLOOR FOR THE PLASMA FREE FRACTION, and the source sought under the second-source rule because fagerholm2021labvariability's competing 2.0-fold figure carries a Prosilico conflict; this one is independent of it ("The authors declare no conflicts of interest", p. 12; "This work received no external funding", p. 12). NOTE THE QUANTITY: this paper measures the fraction unbound in PLASMA, not the unbound fraction in brain. Kp,uu,brain = Kp,brain x fu,plasma / fu,brain, so these figures bear on the project's inputs through the plasma term only; there is still no published interlaboratory figure for fu,brain or for Kp,uu,brain itself. THE HEADLINE FIGURE: "The in vitro f[u] values generally showed good intralab precision (CV < 30%), and the interlab precision was higher (average CV about 70%)" (Discussion, p. 10) - i.e. between laboratories the assay is roughly two to three times noisier than within one. Accuracy, by company, before post hoc curation: "10 of 11 companies achieved >80% reported values within 3-fold of the overall consensus f[u] value derived from the 3 methods. Seven of 11 companies achieved an overall average absolute fold error (AAFE) <= 2 [...] 2 companies (MT and DK) performed exceptionally well, with >=94% of reported values falling within 3-fold of consensus f[u] value and an overall AAFE <= 1.7. In contrast, one company (BL) lagged with only 60% of reported values falling within 3-fold of consensus f[u] value and an overall AAFE >= 4.6" (section 3.2, p. 8); after curation "9 of 11 companies achieving an overall AAFE <= 2", though "excluding these data did not meaningfully alter the results or conclusions". Quote the curation state with the figure: the Discussion (p. 10) gives "6/11" for the curated dataset where section 3.2 gives 7/11 uncurated and 9/11 curated, and the supplemental tables that would settle it were not supplied. By method against consensus: "100% within 3-fold; 90% within 2.1-fold; r2 >= 0.947" (p. 5). Design: 11 pseudonymised companies (AE, BL, DK, LF, MT, NR, PG, SN, TP, UT, XS), 20 compounds all with fu < 1%, 3 methods - equilibrium dialysis by all 11 (RED device 8, HTD device 3), flux dialysis BY ONE COMPANY on 18 compounds, plasma P450 IC50 shift BY ONE COMPANY on 8, so only the dialysis leg is a true eleven-laboratory comparison. ON STRATIFYING COLLATED VALUES BY ASSAY, which the owner asked about on 27 October 2026: within equilibrium dialysis the device effect is "minor", under 1.25-fold for 14 of 20 compounds, but for fingolimod, itraconazole, lapatinib, venetoclax, verlukast and zafirlukast the HTD values run "2.1-fold to 3.4-fold greater" than RED (section 3.4, p. 9) - a real effect, compound-specific, with no conversion coefficient given, so it does not yield a correction applicable to a collated value whose device is unrecorded. Bearing on a study drug: THIORIDAZINE is one of the 20, is an admitted study drug carrying 9 collated Kp,uu,brain values spanning 0.26 to 2.24, and is named among the compounds showing saturable plasma protein binding, with a ">2-fold increase in f[u] upon plasma dilution" (p. 10); diflunisal is also an admitted study drug and warfarin carries the verdict admitted. Supersedes the unquantified cross-company concordance of di2017proteinbinding, this paper's reference 6, whose warfarin and itraconazole are both in the 20. FULL TEXT READ IN FULL ON FABLE ON 27 OCTOBER 2026 from the owner-supplied publisher PDF, data/raw/supplied_papers/pmid42612543_kazmi2026.pdf, SHA-256 9394aee8e3fb0f6c26e57902dd824234d78c8f0c659dc24fe8be1a74e98117c7 matching its pin; supplemental tables not supplied and not held. LICENCE VERIFIED AND RESTRICTIVE: "0090-9556/(c) 2026 American Society for Pharmacology and Experimental Therapeutics. Published by Elsevier Inc. All rights reserved, including those for text and data mining, AI training, and similar technologies" (page 1 footer, repeated on page 2); not open access (Europe PMC isOpenAccess N). So no table or per-compound value from it is to be copied into a repository data file. The reading record is kazmi2026_findings_fable.md}
}

@article{wang2014ppbvariability,
  author  = {Wang, Haiping and Zrada, Matt and Anderson, Ken and Katwaru, Ravi and Harradine, Paul and Choi, Bernard and Tong, Vince and Pajkovic, Natasa and Mazenko, Ralph and Cox, Kathy and Cohen, Lucinda H.},
  title   = {Understanding and reducing the experimental variability of in vitro plasma protein binding measurements},
  journal = {Journal of Pharmaceutical Sciences},
  year    = {2014},
  volume  = {103},
  number  = {10},
  pages   = {3302--3309},
  doi     = {10.1002/jps.24119},
  pmid    = {25116691},
  note    = {THE STANDARDISED WITHIN-COMPANY BETWEEN-SITE CASE for the plasma free fraction, the lower rung of the three-rung ladder amendment item 36 rests on, and one of the three unconflicted sources the owner approved on 27 October 2026 ("the 3 unconflicted ones should be added"). Merck Research Laboratories, Rahway; independent of Prosilico, and the paper evaluates no commercial prediction product. NOTE THE QUANTITY: fraction unbound in PLASMA (fu,plasma), human plasma for the measurement-system work and rat plasma for the warfarin in-well control chart; nothing about the unbound fraction in brain, so it bears on Kp,uu,brain = Kp,brain x fu,plasma / fu,brain through the plasma term only. WHAT IT MEASURES: sources of variability within one company's standardised assay - "Sources of variability were assessed including well position, day-to-day, and site-to-site reproducibility" (abstract, PubMed 25116691 and Europe PMC, read 27 October 2026). WHAT IT DOES NOT MEASURE: variability between independent laboratories running their own protocols, which is the condition this repository's collated values are in; its two sites are two laboratories of ONE company operating "a single analytical procedure for each assay" after a 2007 standardisation programme (Introduction), and the measurement-systems leg used one scientist: "The same scientist conducted the experiment on 3 separate days using the same instrument at each site for two Merck laboratories" (Results and Discussion). EVEN SO THE TWO SITES DIFFERED: the same section begins a sentence "The two Merck sites utilized different incubation conditio..." - the passage returned by the full-text service truncates there, so the clause is recorded as a fact of the paper and not quoted as a complete sentence, and the rest of it is unread. That is the point of the paper: a standardisation programme running since 2007 ("site-specific protocols have been replaced with a single analytical procedure for each assay", Introduction) had still left the two sites incubating differently, and the between-site agreement reported below is what remained after the differences were found and removed. DESIGN: measurement-systems analysis on 2 compounds in human plasma, warfarin (low fu) and clozapine (moderate fu, pH-sensitive), across the whole 96-well HT Dialysis device, 4 h incubation, "In total, 576 measurements were obtained for each compound"; then a design-of-experiments optimisation of pH; then a standardised-method qualification on 6 commercial compounds (clozapine, diltiazem, fluconazole, fluoxetine, verapamil, warfarin) on 3 separate days at each of the 2 sites, 6 replicates with a warfarin in-well control; plus a warfarin in-well-control chart over 16 batch runs at the two sites, "over 6000 measurements in total". THE PAPER STATES NO BETWEEN-SITE FOLD FIGURE AND NO BETWEEN-SITE CV. Its site-to-site results are qualitative - before standardisation, "The clozapine dataset represented reasonable reproducibility and repeatability across days and sites" against "significantly more outliers were observed across both sites and days for warfarin"; after standardisation, "In contrast with the original results of the MSA assessment, data consistency across and within sites was extremely high" (Results and Discussion). BUT ITS TABLE 4 PUBLISHES THE PER-SITE, PER-DAY fu VALUES for the six compounds, from which a between-site figure is computable; computed by the Fable pass of 27 October 2026 on those published numbers, and NOT STATED BY THE PAPER: median site-2-over-site-1 ratio of the three-day means 1.29 (range 1.02 for fluconazole to 1.60 for fluoxetine, site 2 higher than site 1 for all six compounds, so a systematic offset and not only scatter), and median max-over-min across all six observations per compound 1.61 (range 1.07 to 3.23). Report that arithmetic as derived, with this paper named, never as a figure the authors give. A FURTHER CAUTION ON IT: the paper's own stated acceptable range is breached by individual values in that table (all three site-2 diltiazem values against a stated range of 0.20-0.50, all three site-2 warfarin values against 0.007-0.013, fluoxetine at 0.0253 and 0.0816 against 0.044-0.076), while the paper reports that "the overall mean for each site was within the acceptable range"; and the species of Table 4 is not established by the passages read, so the derived figure should be reported without a species claim until the table's heading is read. MECHANISM, WHICH IS WHAT IT IS MOST USEFUL FOR: "The most significant contributor to variability in PPB determinations was loss of physical integrity of the equilibrium dialysis membrane, most likely because of errors during pipetting" (Conclusions), with 60 outliers in 1152 incubations, 56.6 percent of them high buffer concentrations traced by photographing the device to torn, bent or crimped membranes in named wells, and "no correlation was observed for any of the outliers with respect to well position". Together with the standardisation result this makes the large spread in literature-collated fu a property of condition heterogeneity between laboratories rather than an irreducible limit of the assay. It also records the community convention this project's 2-fold language comes from: "generally the most popular and mathematically rigorous proposed range is twofold values, although this is not universally deemed appropriate. However, twofold variability for highly bound values (<0.001 unbound fraction) is generally viewed as unacceptable". FULL TEXT READ ON FABLE ON 27 OCTOBER 2026 through the Wiley Scholar Gateway full-text service, which returned the Abstract, Introduction, Results and Discussion and Conclusions as passages with Tables 1 and 4; the figures themselves (Figs. 1-6) are images and were not seen, so any quantity that lives only in a figure is unread. The publisher's own article page, onlinelibrary.wiley.com/doi/10.1002/jps.24119, answered HTTP 403 to experiments/read_public_page.py on 27 October 2026 and the refusal is respected; there is no PMC record. LICENCE VERIFIED AND RESTRICTIVE: "(c) 2014 Wiley Periodicals, Inc. and the American Pharmacists Association" - the publisher's own copyright line, carried in the article's abstract text and read there in two places on 27 October 2026, PubMed 25116691 and Europe PMC resultType=core, and repeated as PubMed's copyright record ("holder": "Wiley Periodicals"). Not open access: Europe PMC isOpenAccess N, inPMC N, its only full-text route "Subscription required"; Crossref registers for this DOI one licence only, Elsevier's text-and-data-mining user licence (elsevier.com/tdm/userlicense/1.0/), and no Creative Commons licence. So quoted sentences and derived arithmetic only; no table of this paper is to be copied into a repository data file. The reading record is xenobiotica_standing_fable.md section 3.3 and the Fable pass of 27 October 2026}
}

@article{ryu2019orthogonalppb,
  author  = {Ryu, Sangwoo and Riccardi, Keith and Patel, Roshan and Zueva, Larisa and Burchett, Woodrow and Di, Li},
  title   = {Applying Two Orthogonal Methods to Assess Accuracy of Plasma Protein Binding Measurements for Highly Bound Compounds},
  journal = {Journal of Pharmaceutical Sciences},
  year    = {2019},
  volume  = {108},
  number  = {11},
  pages   = {3745--3749},
  doi     = {10.1016/j.xphs.2019.08.004},
  pmid    = {31419399},
  note    = {THE METHOD-AGAINST-METHOD AGREEMENT INSIDE ONE LABORATORY for the plasma free fraction, cited in amendment item 36 as the answer to "is the 2-fold number of fagerholm2021labvariability the same quantity?" - it is not. One of the three unconflicted sources the owner approved on 27 October 2026 ("the 3 unconflicted ones should be added"). Pfizer Worldwide Research and Development, Groton; independent of Prosilico, and the paper evaluates no commercial prediction product. NOT INDEPENDENT OF riccardi2015challenging, whose authors include the same Keith Riccardi and Li Di in the same Pfizer group, so the two are one laboratory's work and are not two sources for the second-source rule. NOTE THE QUANTITY: fraction unbound in PLASMA, and the agreement measured is BETWEEN TWO METHODS IN ONE LABORATORY, not between laboratories and not between sites. WHAT IT GIVES: "2 orthogonal methods, equilibrium dialysis and ultracentrifugation, are assessed in this study to measure PPB of 10 highly bound drugs (f[u] < 0.01). The results show that the 2 very different methods yield comparable f[u] values, generally within 2-fold of each other" (abstract, PubMed 31419399 and Europe PMC, read 27 October 2026; PubMed's rendering strips the subscript on fu). So its 2-fold is the same NUMBER as fagerholm2021labvariability's 2.0-fold median and a DIFFERENT QUANTITY: 10 highly bound drugs, two methods, one laboratory, against 117 compounds collated across laboratories, methods and conditions. It is therefore a bound on the method term alone, and it cannot be read as reproducing or as contradicting the Fagerholm figure. WHAT IT DOES NOT MEASURE: between-laboratory spread, fu,brain, and Kp,uu,brain. WHY IT MATTERS TO THIS PROJECT ANYWAY: its subject is the regulatory 0.01 cutoff - "current regulatory guidelines recommend using an arbitrary cutoff fraction unbound (f[u]) of 0.01 as the lower limit for drug-drug interaction (DDI) prediction. This can result in significant overprediction of DDI for highly bound compounds" - which is the question kazmi2026iqconsortium later settles across 11 companies, and this paper is one of its precursors. ABSTRACT ONLY: the full text was not reached. ScienceDirect (sciencedirect.com, the publisher's host) answered HTTP 403 to experiments/read_public_page.py on 27 October 2026, which is respected as a refusal; Europe PMC records inPMC N, inEPMC N and one full-text route, "Subscription required"; there is no PMC id. So the per-drug table of the 10 compounds, and whether any of them is one of the 222 study drugs, are unread. LICENCE VERIFIED AND RESTRICTIVE: "Copyright (c) 2019 American Pharmacists Association(R). Published by Elsevier Inc. All rights reserved." (PubMed copyright record for PMID 31419399, read 27 October 2026, which types it "All rights reserved"), corroborated by Crossref, which registers for this DOI only Elsevier's text-and-data-mining user licence (elsevier.com/tdm/userlicense/1.0/) and no Creative Commons licence, and by Europe PMC isOpenAccess N. Quoted sentences only. The reading record is xenobiotica_standing_fable.md section 3.3 and the Fable pass of 27 October 2026}
}

@article{lynn2025crossspeciesplasma,
  author  = {Lynn, Scott G. and Schultz, Irvin R. and Matten, Sharlene R. and Patel, Purvi R. and Watson, Scott L. and Yueh, Yun Lan and Black, Sherry R. and Wetmore, Barbara A.},
  title   = {Cross-species comparisons of plasma binding and considerations for data evaluation},
  journal = {Toxicology in Vitro},
  year    = {2025},
  volume  = {106},
  pages   = {106036},
  doi     = {10.1016/j.tiv.2025.106036},
  pmid    = {40023338},
  pmcid   = {PMC12933518},
  note    = {THE GOVERNMENT-AUTHORED CROSS-SPECIES PLASMA-BINDING SOURCE, and the one of the three that bears on BOTH error terms of amendment item 36 - the species translation and the measurement noise. One of the three unconflicted sources the owner approved on 27 October 2026 ("the 3 unconflicted ones should be added"). US Environmental Protection Agency (Office of Pesticide Programs, Office of Program Support, and the Center for Computational Toxicology and Exposure), with the National Marine Fisheries Service of NOAA and RTI International; wholly independent of Prosilico and of any prediction product. NOTE THE QUANTITY: fraction unbound in PLASMA (fu,p) in three species - human, rat and rainbow trout - so it speaks to the fu,plasma term of Kp,uu,brain = Kp,brain x fu,plasma / fu,brain and to nothing about fu,brain or Kp,uu,brain. NOTE THE CHEMICALS: these are environmental chemicals assessed as new approach methods for toxicokinetics, not the project's centrally acting drugs, so no value of it enters any table and its compound set does not overlap the 222 study drugs by construction. DESIGN: "plasma binding experiments using rapid equilibrium dialysis (RED) devices and plasma from humans, rats, and rainbow trout with a 4-h incubation time. A total of 54 chemicals, utilizing two concentrations, were tested across the three species resulting in 238 chemical-species specific datasets. Mass balance controls for chemical plasma stability and dialysis system recovery were used to evaluate the datasets and almost 40 % of the datasets (92/238 datasets) produced quantitative measurements" (abstract, PubMed 40023338 and Europe PMC, read 27 October 2026). That 92-of-238 yield is itself the most quotable thing in it for this project: under mass-balance quality control, three in five chemical-species plasma-binding determinations did not produce a quantitative measurement at all. WHAT IT SUPPORTS ON THE SPECIES TERM, with a stated direction: "Comparisons of human-rat plasma binding revealed rat plasma generally demonstrated higher f[u,p] values for chemicals than human. While f[u,p] values in trout plasma were frequently lower than rat or human plasma." A directional, unquantified rat-against-human difference in the plasma free fraction - the first source in this repository to give one in that pair for fu,plasma, and it points the same way item 36's disclosure already does, that cross-species transfer of this input is an unquantified error. WHAT IT SUPPORTS ON THE NOISE TERM, and the care it needs: "The broader analysis of f[u,p] values indicates that chemicals with log K[ow] > 4.5 will be highly bound (f[u,p] <= 0.0001), difficult to measure, and have low reproducibility across laboratories, suggesting that use of different methods may be needed across different physicochemical properties." THIS IS NOT AN INTERLABORATORY MEASUREMENT OF THEIR OWN. The assays were run in one laboratory and the cross-laboratory statement arises from the paper's comparison with literature values ("A comparison with literature data was performed"), so it is a property-dependent qualitative claim, not a figure; read alongside kazmi2026iqconsortium, whose 20 compounds are all below 1 percent unbound and which finds the opposite on variability at low fu ("binding measurements for highly bound compounds do not necessarily show greater variability", p. 10), the two are reconcilable only because Kazmi's laboratories qualified their assays for the range and Lynn's literature comparators did not - which is the distinction item 36 turns on. ABSTRACT ONLY: THE FULL TEXT WAS NOT REACHED, and the brief that commissioned this entry was wrong that it is open access. It is NOT open access. Routes tried on 27 October 2026, all recorded: the PubMed MCP full-text tool returned an empty full_text for PMC12933518; the Europe PMC fullTextXML service for PMC12933518 answered HTTP 500 on three attempts; europepmc.org/article/MED/40023338 is disallowed by that site's robots file; pmc.ncbi.nlm.nih.gov/articles/PMC12933518/ answered with a reCAPTCHA interstitial ("Checking your browser before accessing pmc.ncbi.nlm.nih.gov"), which is a check that the visitor is human and is respected as a refusal; sciencedirect.com answered HTTP 403; cfpub.epa.gov's Science Inventory search is disallowed by robots. Each refusal was recorded and none was read through a cache or a mirror. So the section that carries the human-rat comparison, and whether the "low reproducibility across laboratories" clause cites other work, are unread. LICENCE OF THE ARTICLE, VERIFIED AND RESTRICTIVE: "Published by Elsevier Ltd." (PubMed copyright record for PMID 40023338, read 27 October 2026, typed not open access), corroborated by Crossref, which registers for this DOI only Elsevier's text-and-data-mining licences (elsevier.com/tdm/userlicense/1.0/ and elsevier.com/legal/tdmrep-license) and no Creative Commons licence, and by Europe PMC isOpenAccess N - although Europe PMC does record inPMC Y, so a free-to-read copy exists in PMC behind the human check above. LICENCE OF THE UNDERLYING DATA, VERIFIED AND PERMISSIVE, AND THE ROUTE TO PREFER: the paper's supplemental tables are published separately by the EPA as a dataset in its own right, "Supplemental Tables 2024-06-06-STICS.xlsx" under doi 10.23719/1532041, listed at catalog.data.gov (read 27 October 2026) with the licence pasteur.epa.gov/license/sciencehub-license.html, which reads "Unless otherwise specified, all data produced by the U.S EPA is by default in the public domain and is not subject to domestic copyright protection under 17 U.S.C. 105" (read 27 October 2026 with experiments/read_public_page.py, sha256 5a92f2b7af009d5dea272a6701ad2a63f22e5f772d0f89f50255e994433fdd11). So any per-chemical number of this study that the project ever wants is taken from the EPA dataset, which is public domain, and not transcribed from the Elsevier article. The reading record is xenobiotica_standing_fable.md section 3.3 and the Fable pass of 27 October 2026}
}

